# Get a free key at aistudio.google.com — no credit card needed.
# Only required if you want Gemini as a fallback when Ollama isn't running.
GEMINI_API_KEY=

# Ollama model to use (must be pulled first: ollama pull <model>)
OLLAMA_MODEL=llama3.2:3b

# Whisper model size: tiny | base | small | medium
# base = good accuracy, ~0.4s/clip on Apple Silicon
WHISPER_MODEL=base

# Seconds before a medium-risk command auto-cancels (0 = no timeout)
VOCTERM_CONFIRM_TIMEOUT=30
